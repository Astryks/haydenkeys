# Node (only needed for Capacitor CLI tooling — the web app itself has
# no build step and no node dependency at runtime)
node_modules/

# iOS / Xcode / CocoaPods build artifacts — regenerated by Xcode or
# `pod install`, never hand-edited, shouldn't be committed. The actual
# ios/App/App.xcodeproj project file IS committed (small, and gives Sid
# a ready-to-open project without regenerating it from scratch).
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/.build/
**/*.xcuserstate
**/xcuserdata/
**/*.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Built by scripts/build-www.sh for Capacitor (real copies of the site)
www/
